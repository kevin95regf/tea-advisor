/* 全局样式。小程序里 rpx 为基准单位：750rpx = 屏幕宽度 */
page {
  background: #f7f5f0;
  color: #2e2a24;
  font-size: 30rpx;
  line-height: 1.65;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.wrap {
  padding: 28rpx 30rpx 60rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e6e1d8;
  border-radius: 22rpx;
  padding: 30rpx;
  margin-bottom: 26rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #2e2a24;
}

.muted {
  color: #8a8177;
  font-size: 24rpx;
}

.hint-box {
  color: #8a8177;
  font-size: 24rpx;
  line-height: 1.7;
}

/* 寒热属性标签 */
.tag {
  display: inline-block;
  font-size: 24rpx;
  padding: 4rpx 18rpx;
  border-radius: 30rpx;
  margin: 0 12rpx 12rpx 0;
  background: #efeae0;
  color: #5f574a;
}

.tag-cold,
.tag-cool {
  background: #e2edf5;
  color: #4a7fa7;
}

.tag-warm {
  background: #f8ebe1;
  color: #c47a4a;
}

.tag-hot {
  background: #f9e3dd;
  color: #b4553f;
}

.tag-neutral {
  background: #eeece5;
  color: #8a8577;
}

/* 理由高亮块 */
.reason {
  background: #fbf8f1;
  border-left: 6rpx solid #7a6a4f;
  border-radius: 0 16rpx 16rpx 0;
  padding: 20rpx 24rpx;
  margin: 20rpx 0;
  font-size: 28rpx;
  line-height: 1.7;
}

.warn-text {
  color: #b4553f;
}

.divider {
  height: 1rpx;
  background: #e6e1d8;
  margin: 24rpx 0;
}
