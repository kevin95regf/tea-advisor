<view class="wrap">

  <!-- 顶部说明 -->
  <view class="head">
    <view class="head-title">说说你今天吃了什么</view>
    <view class="head-sub">结合你的体质，给一杯药食同源饮片的冲泡建议</view>
  </view>

  <!-- 后端连通状态：连不上时给出可操作的提示，而不是让人干瞪眼 -->
  <view wx:if="{{healthChecked && !backendOk}}" class="card warn-card">
    <view class="card-title warn-text">连不上后端服务</view>
    <view class="hint-box">
      当前请求地址（点一下可复制）：{{'\n'}}
      <text class="mono" bindtap="copyApiBase">{{apiBase}}</text>{{'\n'}}
      请依次检查：{{'\n'}}
      1. 后端是否在运行：{{'\n'}}
      <text class="mono">uvicorn app.main:app --host 0.0.0.0 --port 8000</text>{{'\n'}}
      2. <text class="mono">miniprogram/config/env.js</text> 里的 IP 是否是电脑当前的局域网 IP{{'\n'}}
      3. 开发者工具「详情 → 本地设置」勾选「不校验合法域名」
    </view>
    <button class="btn-ghost" bindtap="recheck">重新检测</button>
  </view>

  <!-- 输入 -->
  <view class="card">
    <!-- 标签行：让"这里要输入"一目了然 -->
    <view class="field-head">
      <text class="field-label">描述</text>
      <view class="field-right">
        <text class="counter">{{text.length}}/{{maxLen}}</text>
        <text wx:if="{{text}}" class="clear-btn" bindtap="clearText">清空</text>
      </view>
    </view>

    <view class="input-box">
      <textarea
        class="input"
        value="{{text}}"
        bindinput="onInput"
        bindblur="onTextareaBlur"
        focus="{{inputFocus}}"
        maxlength="{{maxLen}}"
        placeholder="在这里写你今天吃了什么…"
        placeholder-class="ph"
        auto-height
        show-confirm-bar="{{false}}"
        cursor-spacing="24"
      />
    </view>

    <view class="examples-tip">
      {{text ? '再点一句可以续写（不会覆盖你写的内容）：' : '或者点一句示例直接填入：'}}
    </view>

    <!-- 示例，点一下填入；已有内容时追加而不是覆盖 -->
    <view class="examples">
      <view
        wx:for="{{examples}}"
        wx:key="index"
        class="example {{usedExamples.indexOf(index) >= 0 ? 'example-used' : ''}}"
        data-text="{{item}}"
        data-index="{{index}}"
        bindtap="useExample"
      >{{item}}</view>
    </view>
  </view>

  <!-- 体质 -->
  <view class="card">
    <view class="card-title">我的体质</view>
    <picker
      mode="selector"
      range="{{constitutions}}"
      range-key="label"
      value="{{constIndex}}"
      bindchange="onConstChange"
    >
      <view class="picker-row">
        <text class="picker-value {{constPicked ? '' : 'picker-unset'}}">
          {{constPicked ? constitutions[constIndex].label : '请选择你的体质'}}
        </text>
        <text class="picker-arrow">{{constPicked ? '切换' : '选择'}} ›</text>
      </view>
    </picker>

    <!-- 未选择时给默认说明，不冒充平和质 -->
    <view class="hint-box">
      {{constPicked ? constitutions[constIndex].one_line : '不选的话会按「平和质」给出偏中性的建议，准确度会低一些。'}}
    </view>
    <view class="hint-box mt">体质仅用于饮食养生方向的粗略区分，不构成体质辨识或医学诊断。</view>
  </view>

  <!-- 提交 -->
  <button
    class="btn-primary"
    bindtap="submit"
    disabled="{{!text || loading || (healthChecked && !backendOk)}}"
  >
    {{loading ? '正在生成…' : (healthChecked && !backendOk ? '后端未连接' : '给我建议')}}
  </button>

  <view wx:if="{{backendOk && healthMs}}" class="foot-note">
    后端连接正常（{{healthMs}}ms）· 生成建议约需 12–18 秒
  </view>
  <view wx:else class="foot-note">
    会依次做两件事：先把你的描述解析成结构化数据，再结合体质生成搭配。
    大约需要 12–18 秒，请稍等。
  </view>

</view>
