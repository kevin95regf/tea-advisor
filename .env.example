# 应用配置模板。复制为 .env 后按需修改。
#
# ⚠️ 重要约束：本文件（以及你复制出的 .env）里**不能出现任何 DSH_* 变量**。
# dsh 启动时会扫描 workspace 根目录的 .env，发现 DSH_* 就直接拒绝启动：
#   Error: dsh: .env sets "DSH_HOME", which only the launching environment may set
# 原因：DSH_HOME / DSH_MAX_TOKENS 等决定进程如何启动与联网，属于「启动环境专属」变量。
# 同理 DEEPSEEK_API_KEY 也不能放这里 —— 所以凭据要放 credentials.env。
#
# 本项目的分工是：
#   .env              —— 只放应用自己的配置（TA_ 前缀 + 端口 + 超时）
#   credentials.env   —— 放 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DSH_HOME
#                        （dsh 不扫描这个文件名）
# 两个文件的模板见 credentials.env.example。

# ===== Agent 后端 =====
# direct（默认）：直连 DeepSeek 官方 API。API Key 逐请求传入，
#                 因此支持「用户在界面里填自己的 Key」，不落盘、不写运行时目录。
# dsh：走 DeepSeekHarness 子进程。Key 与 harness 实例绑定（一个进程一个 Key），
#      **不支持逐请求换 Key**；保留用于调试。
TA_BACKEND=direct

# ===== 模型 =====
TA_PROVIDER=deepseek-official
TA_MODEL=deepseek-v4-flash
# 思考强度：off / low / high / max
#   off  → 关闭思考：最快、最便宜（实测同一任务输出 token 从 135 降到 5），
#          但推荐条数与说明详细度会下降。适合只查属性、或极度在意成本的场景。
#   low  → 默认。质量与 max 同级，延迟约 1/2。
#   high / max → 更慢更贵，用于对照实验。
# 说明：dsh 后端只接受 max / high / low / off，其余取值会导致启动失败；
#       direct 后端对 medium / none / minimal 等未知取值会按 low 处理并记警告。
# 实测（Agent2 真实推荐）：max 19.2s→3条 | high 10.1s→3条 | low 8.2s→3条 | off 2.7s→1条
TA_REASONING_EFFORT=low
# 注意：思考模式下 max_tokens 若太小会被思考耗尽，正文返回空字符串。
TA_MAX_TOKENS=8192

# ===== 服务 =====
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ===== 超时（秒）=====
AGENT1_TIMEOUT_S=45
AGENT2_TIMEOUT_S=60
