# 应用配置模板。复制为 .env 后按需修改。
#
# ⚠️ 重要约束：本文件（以及你复制出的 .env）里**不能出现任何 DSH_* 变量**。
# dsh 启动时会扫描 workspace 根目录的 .env，发现 DSH_* 就直接拒绝启动：
#   Error: dsh: .env sets "DSH_HOME", which only the launching environment may set
# 原因：DSH_HOME / DSH_MAX_TOKENS 等决定进程如何启动与联网，属于「启动环境专属」变量。
#
# 因此本项目的分工是：
#   .env              —— 只放应用自己的配置（TA_ 前缀 + 端口 + 超时）
#   credentials.env   —— 放 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DSH_HOME
#                        （dsh 不扫描这个文件名，由 backend/app/agents/runtime.py
#                         读取后注入子进程环境）
# 两个文件的模板见 credentials.env.example。

# ===== 模型 =====
TA_PROVIDER=deepseek-official
TA_MODEL=deepseek-v4-flash
# 本模型支持 max / high / low / off；medium、none、minimal 会导致启动失败。
# 实测同一任务（Agent2 真实推荐）：max 19.2s→3条 | high 10.1s→3条 | low 8.2s→3条 | off 2.7s→1条
TA_REASONING_EFFORT=low
TA_MAX_TOKENS=8192

# ===== 服务 =====
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ===== 超时（秒）=====
AGENT1_TIMEOUT_S=45
AGENT2_TIMEOUT_S=60
