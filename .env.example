# 复制本文件为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会入库。

# ===== 必填：DeepSeek 凭据 =====
DEEPSEEK_API_KEY=sk-在此填入你的key
# 使用兼容代理端点时取消注释
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== 必填：DSH 运行时 home（纯英文绝对路径，且与主 DSH 环境隔离）=====
DSH_HOME=D:\work\dsh-home

# ===== 模型 =====
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
DSH_REASONING_EFFORT=max
DSH_MAX_TOKENS=8192

# ===== 服务 =====
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ===== 超时（秒）=====
AGENT1_TIMEOUT_S=45
AGENT2_TIMEOUT_S=60
