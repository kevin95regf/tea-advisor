# 凭据与运行时 home 模板。复制为 credentials.env 后填入真实值。
#
# 为什么单独一个文件：dsh 会扫描 workspace 根目录的 .env 并拒绝其中的
# DSH_* 与凭据变量，所以这些「启动环境专属」的值必须放在 dsh 不扫描的
# 文件里，由 core/app/config.py 读取、core/app/agents/runtime.py
# 注入子进程环境。

# ===== 凭据（必填）=====
DEEPSEEK_API_KEY=sk-在此填入你的key
# 走兼容代理端点时取消注释
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== DSH 运行时 home（必填，纯英文绝对路径）=====
# 不设置会继承 DSH 主环境的 DSH_HOME，导致 SDK 往主环境写 profile 与会话。
DSH_HOME=D:\work\tea-advisor\dsh-home
